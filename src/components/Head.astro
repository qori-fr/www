---
import { siteConfig } from '../config';
import '../styles/global.css';
import {
  defaultOgImage,
  hreflangUrls,
  professionalServiceJsonLd,
  seoDefaults,
} from '../seo';

interface Props {
  title: string;
  description: string;
  lang: string;
  noindex?: boolean;
}

const { title, description, lang, noindex = false } = Astro.props;
const locale = lang === 'fr' ? 'fr' : 'es';
const defaults = seoDefaults[locale];
const rawTitle = title?.trim() ?? '';
const shouty =
  rawTitle.length > 20 &&
  rawTitle === rawTitle.toUpperCase();
const shortTitle = rawTitle && rawTitle.length < 60 && !shouty ? rawTitle : defaults.title;
const fullTitle = shortTitle.includes('Qori') ? shortTitle : `${shortTitle} | Qori`;
const metaDescription = description?.trim() || defaults.description;
const { canonical, other, otherLang, xDefault } = hreflangUrls(Astro.url.pathname, locale);
const selfHreflang = locale === 'fr' ? 'fr-FR' : 'es-ES';
const otherHreflang = otherLang === 'fr' ? 'fr-FR' : 'es-ES';
const ogImage = new URL(defaultOgImage, 'https://qori.fr').href;
const themeVars = `:root { --primary-color: ${siteConfig.primaryColor}; --nav-color: ${siteConfig.navColor}; }`;
const jsonLd = JSON.stringify(professionalServiceJsonLd());
---

<meta charset="utf-8" />
<title>{fullTitle}</title>
<style is:global set:html={themeVars} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={metaDescription} />
<meta name="author" content={siteConfig.author} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={selfHreflang} href={canonical} />
<link rel="alternate" hreflang={otherHreflang} href={other} />
<link rel="alternate" hreflang="x-default" href={xDefault} />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteConfig.title} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'es_ES'} />
<meta property="og:locale:alternate" content={locale === 'fr' ? 'es_ES' : 'fr_FR'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

<link rel="stylesheet" href={siteConfig.plugins.css[0].link} />
<link rel="stylesheet" href={siteConfig.plugins.css[1].link} media="print" onload="this.media='all'" />
<link rel="stylesheet" href={siteConfig.plugins.css[2].link} media="print" onload="this.media='all'" />
<link rel="stylesheet" href={siteConfig.plugins.css[3].link} media="print" onload="this.media='all'" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://cdn.jsdelivr.net" />
<link rel="preconnect" href="https://code.jquery.com" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" />
<link rel="shortcut icon" href="/images/favicon.png" type="image/png" />
<link rel="icon" href="/images/favicon.png" type="image/png" />

<script type="application/ld+json" set:html={jsonLd} />
